# The port here must match the one docker-compose.yml published: 5432 by default, or whatever
# POSTGRES_PORT was set to. tests/setup.ts reads this file; if you only want to change the port,
# set POSTGRES_PORT here instead and delete this line — setup.ts builds the URL from it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veritrust_test"
REDIS_URL="redis://localhost:6379/1"
HASH_PEPPER=test-pepper-test-pepper-test-pepper-0000
JWT_ACCESS_SECRET=test-jwt-secret-test-jwt-secret-test-jwt-secret
JOIN_TOKEN_SECRET=test-join-secret-test-join-secret-test-join-secret
CANDIDATE_TOKEN_SECRET=test-candidate-secret-test-candidate-secret
MAIL_PROVIDER=log
STORAGE_LOCAL_DIR=./.test-storage
INTERNAL_SERVICE_TOKEN=test-internal-token-test-internal-token
# EVIDENCE_SIGNING_PRIVATE_KEY / EVIDENCE_SIGNING_KEY_ID have working defaults in tests/setup.ts
