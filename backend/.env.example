# ---- Server ----
NODE_ENV=development
PORT=9000
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:9000
CORS_ORIGINS=http://localhost:3000

# ---- Data ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veritrust"
REDIS_URL="redis://localhost:6379"

# ---- Secrets (generate with: npm run keys:generate) ----
HASH_PEPPER=
JWT_ACCESS_SECRET=
JWT_REFRESH_TTL_DAYS=30
EVIDENCE_SIGNING_PRIVATE_KEY=
EVIDENCE_SIGNING_KEY_ID=local-dev-1

# ---- Providers ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
MAIL_PROVIDER=smtp            # smtp | log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VeriTrust <no-reply@veritrust.local>"
LLM_PROVIDER=mock
MEDIA_PROVIDER=mock
SANDBOX_PROVIDER=mock
