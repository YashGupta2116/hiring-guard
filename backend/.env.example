# ---- Server ----
NODE_ENV=development
PORT=9000
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:9000
CORS_ORIGINS=http://localhost:3000

# ---- Data ----
# POSTGRES_PORT is read by docker-compose.yml for the host port mapping only. If something
# already owns 5432 (a native Postgres install is the usual culprit), set it here AND use the
# same port in DATABASE_URL below -- compose reads this file for interpolation.
# POSTGRES_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veritrust"
REDIS_URL="redis://localhost:6379"

# ---- Scoring ----
# Adopt ml/weights/weights.json's fitted curves as LLR_TABLE magnitudes. Off by default: turning
# it on changes live integrity scores, so it is a decision rather than a default. The committed
# artifact is fitted on SYNTHETIC fixtures and is not evidence about real candidate behaviour.
CALIBRATED_WEIGHTS_ENABLED=false

# ---- Secrets (generate with: npm run keys:generate) ----
HASH_PEPPER=
JWT_ACCESS_SECRET=
JWT_REFRESH_TTL_DAYS=30
JOIN_TOKEN_SECRET=
CANDIDATE_TOKEN_SECRET=
EVIDENCE_SIGNING_PRIVATE_KEY=
EVIDENCE_SIGNING_KEY_ID=local-dev-1

# ---- Providers ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
MAIL_PROVIDER=smtp            # smtp | log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VeriTrust <no-reply@veritrust.local>"
LLM_PROVIDER=mock
MEDIA_PROVIDER=mock
SANDBOX_PROVIDER=mock # mock | docker (docker runs real per-run containers; requires a local Docker daemon)
INTERNAL_SERVICE_TOKEN=
REPORT_PDF_ENABLED=false # PDF rendering (puppeteer) is optional; HTML is always produced

# ---- Retention (Phase 11) ----
RETENTION_MEDIA_DAYS=90
RETENTION_OBSERVATIONS_DAYS=180
RETENTION_EVIDENCE_LOG_FLOOR_DAYS=30
RETENTION_REPORTS_DAYS=1095
RETENTION_CRON="0 3 * * *" # nightly at 03:00, worker process local time
