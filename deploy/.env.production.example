# Copy this file to .env.production ON THE SERVER. It must never be committed.
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=replace-with-a-long-random-password
HASH_PEPPER=replace-with-at-least-32-random-characters
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JOIN_TOKEN_SECRET=replace-with-at-least-32-random-characters
CANDIDATE_TOKEN_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Required, not optional: getSigner() throws (and session-end fails) if this is unset. Generate a
# real one with `cd backend && npm run keys:generate` and paste its two output lines in verbatim.
EVIDENCE_SIGNING_PRIVATE_KEY=
EVIDENCE_SIGNING_KEY_ID=

# TURN relay for the interviewer<->candidate video call, needed when either side is behind a
# strict NAT/firewall (STUN alone isn't enough). Self-hosted by the `turn` service in
# docker-compose.yml on this same server. SERVER_PRIVATE_IP: run `hostname -I | awk '{print $1}'`
# on the host -- both IPs are required together so coturn can unambiguously map one to the other.
SERVER_PUBLIC_IP=replace-with-this-server-s-static-public-ip
SERVER_PRIVATE_IP=replace-with-this-server-s-private-ip
TURN_USERNAME=replace-with-a-username
TURN_PASSWORD=replace-with-a-long-random-password

# Real email instead of the log-only default. Gmail's app password must be pasted with no spaces
# and no surrounding quotes (docker compose's --env-file parser does not strip either).
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-your-gmail-address
SMTP_PASS=replace-with-a-16-char-app-password-no-spaces
MAIL_FROM=Hiring Guard <replace-with-your-gmail-address>

# Real per-run candidate code execution (see backend/src/providers/sandbox/docker.sandbox.ts).
# DOCKER_GID: run `getent group docker | cut -d: -f3` on the host and paste the number here.
SANDBOX_PROVIDER=docker
DOCKER_GID=replace-with-the-host-docker-group-gid

# Real JD parsing / suggestions / grading via Groq's free API (console.groq.com -> API Keys).
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
